{
  "kotlin.languageServer.enabled": true,
  "kotlin.linting.enabled": true,
  "kotlin.formatting.enabled": true,
  "kotlin.completion.snippets.enabled": true,
  "kotlin.debugAdapter.enabled": true,
  "kotlin.trace.server": "messages",
  // Format on save
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  // Kotlin specific formatting
  "[kotlin]": {
    "editor.defaultFormatter": "fwcd.kotlin",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // File associations
  "files.associations": {
    "*.kt": "kotlin",
    "*.kts": "kotlin"
  },
  // Gradle files
  "[gradle]": {
    "editor.defaultFormatter": "naco-siren.gradle-languages"
  },
  // Android specific
  "android.home": "/Users/fakhry/Library/Android/sdk",
  // IntelliJ/Android Studio style formatting
  "kotlin.formatting.codeStyle": "intellij",
  "kotlin.formatting.insertSpacesForTabs": true,
  "kotlin.formatting.tabSize": 4,
  "kotlin.formatting.indentSize": 4,
  "kotlin.formatting.continuationIndentSize": 4,
  // Exclude build directories
  "files.exclude": {
    "**/build": true,
    "**/.gradle": true,
    "**/node_modules": true
  },
  // Search exclude
  "search.exclude": {
    "**/build": true,
    "**/.gradle": true,
    "**/node_modules": true
  },
  "java.configuration.updateBuildConfiguration": "automatic"
}